{
  "name": "block-pramana",
  "version": "0.1.0",
  "private": true,
  "description": "A self-hostable API for inspecting token data with explicit on-chain evidence.",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.4.3",
  "engines": {
    "bun": ">=1.4.3"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "test": "bun test",
    "smoke:live": "bun scripts/smoke-live.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "bun build src/index.ts --target bun --outdir dist",
    "check": "bun run format:check && bun run typecheck && bun test && bun run build"
  },
  "devDependencies": {
    "@types/bun": "1.4.3",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  }
}
